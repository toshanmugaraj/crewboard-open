# Copy this to .env (same directory as docker-compose.prod.yml) and fill in
# real values. .env is picked up automatically by `docker compose`. Do NOT
# commit the real .env — it holds your Postgres password and encryption key.

# Image repos to pull (build+push these yourself from the root/backend
# Dockerfiles first — e.g. `docker build . -t yourdockerhubuser/crewboard-widget`,
# `docker build backend -t yourdockerhubuser/crewboard-backend`, then push).
CREWBOARD_BACKEND_IMAGE=yourdockerhubuser/crewboard-backend
CREWBOARD_FRONTEND_IMAGE=yourdockerhubuser/crewboard-widget

# Image tag to pull for each of the above. Backend and frontend are
# versioned/released independently (separate CI pipelines, separate tags),
# so each gets its own var rather than sharing one — set them independently
# when you only need to redeploy one side (e.g. a backend-only fix like the
# SYNAPSE_FEDERATION_URL one above shouldn't require bumping/redeploying the
# frontend too). Defaults to "latest" if left blank, but pinning to a real
# version/commit-sha tag is strongly preferred — "latest" makes
# `docker compose pull && up -d` non-reproducible (you can't tell which
# build is actually running, and a bad push to "latest" affects you
# immediately with no rollback tag to fall back to).
CREWBOARD_BACKEND_VERSION=latest
CREWBOARD_FRONTEND_VERSION=latest

# ── Traefik (matrix-docker-ansible-deploy style) ────────────────────────────
# The domain CrewBoard should be reachable at. Routed as its OWN subdomain
# (this playbook's Traefik usage is one container = one Host() rule), NOT
# path-shared with your homeserver's domain — e.g. crewboard.example.com.
# Point DNS for this host at your server before deploying.
CREWBOARD_DOMAIN=

# The external Docker network your existing Traefik instance watches —
# matrix-docker-ansible-deploy's default name is `traefik` (confirm with
# `docker network ls` / your vars.yml's
# matrix_playbook_reverse_proxy_container_network). Must already exist —
# docker-compose.prod.yml joins it (external: true), doesn't create it.
TRAEFIK_NETWORK=traefik

# Entrypoint name from your Traefik setup — confirmed from your existing
# matrix-sygnal container's labels as web-secure.
TRAEFIK_ENTRYPOINT=web-secure

# certResolver name for TLS — confirmed blank in your existing
# matrix-sygnal labels (meaning that router relies on a resolver already
# configured elsewhere / a wildcard cert, not per-router ACME). Leave blank
# to match, or set it if your setup actually needs a named resolver here.
TRAEFIK_CERTRESOLVER=

# Postgres password for the crewboard user/database. Pick anything strong;
# only used internally between the backend and postgres containers.
POSTGRES_PASSWORD=

# Where your production Synapse's client-server API is reachable from the
# backend container. Since the backend now joins the same `traefik`
# external network your Synapse container is likely already on, the
# cleanest option is reaching it directly by container/service name over
# that network — e.g. http://matrix-synapse:8008 (matrix-docker-ansible-
# deploy's usual container name/internal port; confirm with `docker
# inspect matrix-synapse` if unsure). Only fall back to
# http://host.docker.internal:<published-port> (docker-compose.prod.yml's
# backend service already has the extra_hosts entry for this) if Synapse
# turns out not to be reachable by container name.
SYNAPSE_BASE_URL=http://matrix-synapse:8008

# Only needed if your Synapse splits the "client" and "federation" resource
# groups across two different ports/listeners in homeserver.yaml (confirmed
# on a real production deployment, 2026-07-28: port 8008 serving ONLY
# `client`, a separate port serving ONLY `federation`). SYNAPSE_BASE_URL
# above is used for the Synapse admin API (/_synapse/admin/v1/... — Synapse
# serves this under the CLIENT resource) and defaults to also being used for
# the OpenID token verification call (/_matrix/federation/v1/openid/userinfo
# — needs the FEDERATION resource). If those two resources live on
# different ports for you, point this at the federation one instead, e.g.
# SYNAPSE_FEDERATION_URL=http://matrix-synapse:8048
# Leave unset if your Synapse serves both resources on the same listener —
# that's the common case and the original assumption this backend shipped
# with.
#SYNAPSE_FEDERATION_URL=http://matrix-synapse:8048

# AES-256-GCM master key (32 random bytes, base64) — encrypts every
# sensitive field this backend still touches as a fallback/legacy path, and
# is the ONLY copy outside room members' own Matrix keys for anything not
# covered by client-side encryption. Generate with:
#   openssl rand -base64 32
# BACK THIS UP somewhere durable (password manager, secrets vault) the
# moment you generate it — losing it makes legacy/fallback-encrypted data
# permanently unreadable, with no recovery path.
ENCRYPTION_KEY=

# Left blank on first deploy — the backend runs in degraded (identity-only)
# auth mode without it: any authenticated user on your homeserver can read
# AND write any room's CrewBoard data, with no moderator/admin-only write
# gate. Fill this in once you've minted a Synapse admin-capable access
# token for a dedicated service account (see README section on this) and
# restart the backend (`docker compose -f docker-compose.prod.yml up -d
# --force-recreate backend`) to pick it up.
SYNAPSE_ADMIN_TOKEN=

# The Matrix room ID CrewBoard is scoped to by default (used as a backfill
# target and as a fallback for older/misconfigured clients that omit the
# X-Crewboard-Room-Id header). Not strictly required, but recommended once
# you know it. Looks like: !abcDEF123:your-homeserver.example.com
CREWBOARD_ROOM_ID=

# ── Plausible analytics (self-hosted, optional, 2026-08-06) ────────────────
# Both left blank = analytics stays off; nothing is sent anywhere. Set both
# to enable. This is CONTAINER-RUNTIME config — the frontend container's
# entrypoint templates these into a small env.js file on every start (see
# /docker-entrypoint.d/40-generate-env-js.sh and frontend/src/analytics.js),
# so changing either value here only needs `docker compose up -d frontend`
# (no rebuild/re-tag of the frontend image required).
#
# Privacy limit (hard-coded in analytics.js, not configurable): every event
# CrewBoard ever sends to Plausible carries AT MOST a Matrix room id and/or
# the sender's own Matrix user id — never a name, phone number, coordinate,
# marker label, message body, or any other field. The event `url` sent to
# Plausible is always a fixed synthetic value, never the real widget URL
# (which carries roomId/baseUrl/tokens in its hash/query).

# Base URL of your self-hosted Plausible instance, reachable from the
# BROWSER (not just the frontend container) — e.g. https://plausible.example.com
# (no trailing slash). CrewBoard posts directly to `${PLAUSIBLE_API_HOST}/api/event`.
PLAUSIBLE_API_HOST=

# The site/domain identifier you registered this deployment under in
# Plausible's own dashboard (Site Settings → General → Domain) — this is
# Plausible's own site key, not a CrewBoard-specific secret. Doesn't need to
# be a real reachable domain — e.g. crewboard.internal is fine, as long as
# it matches what you registered in Plausible.
PLAUSIBLE_DOMAIN=
